{
  "providers": {
    "lmstudio": { "type": "openai-compatible", "baseUrl": "http://localhost:1234/v1" },
    "deepseek": { "type": "deepseek" }
  },
  "models": {
    "local": { "provider": "lmstudio", "model": "<your model>" },
    // effort turns on DeepSeek's thinking mode.
    "remote": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "contextWindow": 1000000,
      "effort": "high"
    },
    "opus": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "contextWindow": 1000000,
      "effort": "high"
    },
    "sonnet": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "contextWindow": 1000000,
      "effort": "high"
    },
    "haiku": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "contextWindow": 1000000,
      "effort": "high"
    }
  }
}
