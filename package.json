{
  "name": "switchback",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run apps/cli/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run --cwd apps/site check && bun run test",
    "build": "bun run --cwd apps/cli build && bun run --cwd apps/vscode build && bun run --cwd apps/site build",
    "schema": "bun scripts/gen-schema.ts && biome format --write apps/vscode/schemas/config.schema.json",
    "test:live": "SWITCHBACK_LIVE=1 bun test tests/live --timeout 600000"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.95.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@switchback/engine": "workspace:*",
    "@switchback/protocol": "workspace:*",
    "@switchback/providers": "workspace:*"
  }
}
