{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "providers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "openai-compatible"
              },
              "baseUrl": {
                "type": "string",
                "format": "uri"
              },
              "apiKey": {
                "type": "string"
              },
              "tier": {
                "default": "local",
                "type": "string",
                "enum": ["local", "remote"]
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": ["type", "baseUrl"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "openai"
              },
              "apiKey": {
                "type": "string"
              },
              "baseUrl": {
                "default": "https://api.openai.com/v1",
                "type": "string",
                "format": "uri"
              },
              "organization": {
                "type": "string"
              },
              "api": {
                "default": "chat",
                "type": "string",
                "enum": ["chat", "responses"]
              }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "deepseek"
              },
              "apiKey": {
                "type": "string"
              },
              "baseUrl": {
                "default": "https://api.deepseek.com",
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "anthropic"
              },
              "apiKey": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string",
                "format": "uri"
              },
              "refusalFallback": {
                "default": "server",
                "type": "string",
                "enum": ["server", "off"]
              }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "bedrock"
              },
              "region": {
                "type": "string"
              },
              "profile": {
                "type": "string"
              },
              "eagerToolInputStreaming": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "vertex"
              },
              "projectId": {
                "type": "string"
              },
              "region": {
                "default": "global",
                "type": "string"
              }
            },
            "required": ["type", "projectId"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "anthropic-aws"
              },
              "region": {
                "type": "string"
              },
              "workspaceId": {
                "type": "string"
              },
              "profile": {
                "type": "string"
              },
              "refusalFallback": {
                "default": "server",
                "type": "string",
                "enum": ["server", "off"]
              }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "foundry"
              },
              "resource": {
                "type": "string"
              },
              "apiKey": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "azure-openai"
              },
              "resource": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string",
                "format": "uri"
              },
              "apiKey": {
                "type": "string"
              },
              "api": {
                "default": "responses",
                "type": "string",
                "enum": ["chat", "responses"]
              }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "gemini"
              },
              "apiKey": {
                "type": "string"
              },
              "project": {
                "type": "string"
              },
              "location": {
                "default": "global",
                "type": "string"
              }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "mock"
              },
              "tier": {
                "default": "local",
                "type": "string",
                "enum": ["local", "remote"]
              }
            },
            "required": ["type"]
          }
        ]
      }
    },
    "models": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "contextWindow": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maxOutputTokens": {
            "default": 16000,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "effort": {
            "type": "string",
            "enum": ["none", "low", "medium", "high", "xhigh", "max"]
          },
          "price": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              },
              "cacheRead": {
                "type": "number"
              },
              "cacheWrite": {
                "type": "number"
              }
            },
            "required": ["input", "output"]
          }
        },
        "required": ["provider", "model"]
      }
    },
    "routing": {
      "default": {},
      "type": "object",
      "properties": {
        "start": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "escalate": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "allowRemote": {
          "default": true,
          "type": "boolean"
        },
        "escalation": {
          "default": {},
          "type": "object",
          "properties": {
            "policy": {
              "default": "auto",
              "type": "string",
              "enum": ["auto", "ask", "off"]
            },
            "maxConsecutiveToolErrors": {
              "default": 3,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxMalformedToolCalls": {
              "default": 2,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "loopThreshold": {
              "default": 3,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "contextHeadroom": {
              "default": 0.85,
              "type": "number",
              "minimum": 0.1,
              "maximum": 1
            },
            "stickyTurns": {
              "default": 2,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "classifier": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "escalateOn": {
              "default": "hard",
              "type": "string",
              "enum": ["medium", "hard"]
            },
            "timeoutMs": {
              "default": 1500,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["model"]
        },
        "budget": {
          "default": {},
          "type": "object",
          "properties": {
            "dailyUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "monthlyUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "onExceeded": {
              "default": "local",
              "type": "string",
              "enum": ["local", "block"]
            }
          }
        },
        "fallback": {
          "default": "nearest",
          "type": "string",
          "enum": ["nearest", "none"]
        }
      }
    },
    "permissions": {
      "default": {},
      "type": "object",
      "properties": {
        "read": {
          "default": "allow",
          "type": "string",
          "enum": ["allow", "ask", "deny"]
        },
        "edit": {
          "default": "ask",
          "type": "string",
          "enum": ["allow", "ask", "deny"]
        },
        "bash": {
          "default": "ask",
          "type": "string",
          "enum": ["allow", "ask", "deny"]
        },
        "mcp": {
          "default": "ask",
          "type": "string",
          "enum": ["allow", "ask", "deny"]
        }
      }
    },
    "mcpServers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "stdio"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "permission": {
                "type": "string",
                "enum": ["allow", "ask", "deny"]
              },
              "enabled": {
                "default": true,
                "type": "boolean"
              },
              "timeoutMs": {
                "default": 60000,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["command"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["http", "sse"]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "headers": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "permission": {
                "type": "string",
                "enum": ["allow", "ask", "deny"]
              },
              "enabled": {
                "default": true,
                "type": "boolean"
              },
              "timeoutMs": {
                "default": 60000,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["url"]
          }
        ]
      }
    },
    "runtimes": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "claude-agent-sdk"
              },
              "model": {
                "type": "string"
              },
              "maxTurns": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "executable": {
                "type": "string"
              }
            },
            "required": ["type"]
          }
        ]
      }
    },
    "defaultAgent": {
      "default": "build",
      "type": "string"
    },
    "subagents": {
      "default": {},
      "type": "object",
      "properties": {
        "maxConcurrent": {
          "default": 4,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDepth": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "budgetUsd": {
          "type": "number",
          "minimum": 0
        },
        "model": {
          "type": "string"
        }
      }
    },
    "maxStepsPerTurn": {
      "default": 50,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "review": {
      "default": {},
      "type": "object",
      "properties": {
        "mode": {
          "default": "off",
          "type": "string",
          "enum": ["off", "auto"]
        },
        "models": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "maxRounds": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "telemetry": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "endpoint": {
          "default": "https://switchback.harville.ai/api/telemetry/v1",
          "type": "string",
          "format": "uri"
        }
      }
    },
    "privacy": {
      "default": {},
      "type": "object",
      "properties": {
        "localOnlyPaths": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "secrets": {
          "default": "redact",
          "type": "string",
          "enum": ["redact", "block", "off"]
        }
      }
    },
    "compaction": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "threshold": {
          "default": 0.7,
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.95
        },
        "keepRecent": {
          "default": 0.25,
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.6
        }
      }
    }
  },
  "title": "Switchback configuration",
  "description": "See docs/configuration.md. String values may reference environment variables as {env:NAME}."
}
