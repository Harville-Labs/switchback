{
  "name": "switchback",
  "displayName": "Switchback",
  "description": "Local-first coding agent that escalates to a hosted model (OpenAI, Anthropic, DeepSeek, ...) only when it needs to.",
  "version": "0.6.0",
  "private": true,
  "publisher": "isaiah-harville",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "homepage": "https://harville.ai/switchback",
  "repository": {
    "type": "git",
    "url": "https://github.com/Harville-Labs/switchback.git",
    "directory": "apps/vscode"
  },
  "bugs": {
    "url": "https://github.com/Harville-Labs/switchback/issues"
  },
  "keywords": [
    "agent",
    "local",
    "ollama",
    "llm",
    "ai",
    "coding agent",
    "openai",
    "anthropic",
    "deepseek",
    "gemini"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "switchback",
          "title": "Switchback",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "switchback": [
        {
          "type": "webview",
          "id": "switchback.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "switchback.newSession",
        "title": "New Session",
        "category": "Switchback",
        "icon": "$(add)"
      },
      {
        "command": "switchback.cancel",
        "title": "Cancel Running Turn",
        "category": "Switchback"
      },
      {
        "command": "switchback.setRoute",
        "title": "Set Routing (auto / local / remote)",
        "category": "Switchback"
      },
      {
        "command": "switchback.showUsage",
        "title": "Show Usage and Savings",
        "category": "Switchback"
      },
      {
        "command": "switchback.setReview",
        "title": "Set Review of Local Edits",
        "category": "Switchback"
      },
      {
        "command": "switchback.chooseModels",
        "title": "Choose Models for This Session…",
        "category": "Switchback"
      },
      {
        "command": "switchback.showReceipt",
        "title": "Show Session Receipt (Cost vs. All-Remote)",
        "category": "Switchback"
      },
      {
        "command": "switchback.compact",
        "title": "Compact Conversation",
        "category": "Switchback"
      },
      {
        "command": "switchback.askAboutSelection",
        "title": "Ask About Selection",
        "category": "Switchback"
      },
      {
        "command": "switchback.restartEngine",
        "title": "Restart Engine",
        "category": "Switchback"
      },
      {
        "command": "switchback.showLogs",
        "title": "Show Engine Logs",
        "category": "Switchback"
      },
      {
        "command": "switchback.installCli",
        "title": "Install Terminal Command",
        "category": "Switchback"
      },
      {
        "command": "switchback.runSetup",
        "title": "Set Up Models",
        "category": "Switchback"
      },
      {
        "command": "switchback.openSession",
        "title": "Open Session…",
        "category": "Switchback",
        "icon": "$(history)"
      },
      {
        "command": "switchback.acceptEdit",
        "title": "Accept Proposed Edit",
        "category": "Switchback",
        "icon": "$(check)"
      },
      {
        "command": "switchback.rejectEdit",
        "title": "Reject Proposed Edit",
        "category": "Switchback",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "switchback.openSession",
          "when": "view == switchback.chat",
          "group": "navigation"
        },
        {
          "command": "switchback.newSession",
          "when": "view == switchback.chat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "switchback.askAboutSelection",
          "when": "editorHasSelection",
          "group": "switchback"
        }
      ],
      "editor/title": [
        {
          "command": "switchback.acceptEdit",
          "when": "resourceScheme == switchback-proposed",
          "group": "navigation@1"
        },
        {
          "command": "switchback.rejectEdit",
          "when": "resourceScheme == switchback-proposed",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "switchback.acceptEdit",
          "when": "resourceScheme == switchback-proposed"
        },
        {
          "command": "switchback.rejectEdit",
          "when": "resourceScheme == switchback-proposed"
        }
      ]
    },
    "configuration": {
      "title": "Switchback",
      "properties": {
        "switchback.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the switchback executable. Empty: the switchback CLI when it's at least as new as the engine bundled with the extension, else the bundled engine. The extension runs `<path> serve --stdio`.",
          "scope": "machine-overridable"
        },
        "switchback.executableArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments inserted before `serve --stdio` (e.g. a script path when executablePath is `bun`)."
        },
        "switchback.defaultRoute": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "remote"
          ],
          "default": "auto",
          "description": "Routing for new prompts. `auto` follows your switchback config."
        },
        "switchback.reviewEditsInDiffEditor": {
          "type": "boolean",
          "default": true,
          "description": "Open proposed edits in the diff editor with Accept / Reject buttons, in addition to the prompt in the chat."
        },
        "switchback.sharedEngine": {
          "type": "boolean",
          "default": true,
          "description": "Attach to the workspace's shared Switchback engine, so the terminal UI and VS Code see the same live sessions. Off: this window runs its own engine."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.switchback/config.json",
          "**/.config/switchback/config.json"
        ],
        "url": "./schemas/config.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "bun build src/extension.ts --target=node --format=cjs --external vscode --outfile dist/extension.js && bun build src/webview/main.ts --target=browser --outfile dist/webview.js",
    "package": "bun run build && cp ../../CHANGELOG.md CHANGELOG.md && vsce package --no-dependencies --baseContentUrl https://github.com/Harville-Labs/switchback/blob/main --baseImagesUrl https://github.com/Harville-Labs/switchback/raw/main",
    "build:test": "bun build test/suite/*.itest.ts --outdir out/test --target node --format cjs --external vscode",
    "test": "bun run build && bun run build:test && vscode-test --label dev",
    "test:bundled": "bun run build && bun run build:test && bun ../cli/scripts/build.ts --outfile bin/switchback && vscode-test --label bundled"
  },
  "dependencies": {
    "@switchback/client": "workspace:*",
    "@switchback/protocol": "workspace:*",
    "dompurify": "^3.4.16",
    "marked": "15"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "happy-dom": "^20.14.5",
    "mocha": "^12.0.2",
    "ovsx": "^1.2.0"
  }
}
